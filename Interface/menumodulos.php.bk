			{
				print "<div id=\"menu1_over\" onclick=\"pliega_despliega ('#menu_dentro0');\">";
			}
			else
			{
				print "<div id=\"menu1\" onclick=\"pliega_despliega ('#menu_dentro0');\">";
			}			
			print "<img src=\"http://".$_SERVER['SERVER_NAME'].$listado->URLIcono."\"><span>".$listado->Nombre."</span>";
			print "</div>";
			if ($modulo=="Especifico") print "<div id=\"menu_dentro_seleccionado\">";
			else print "<div id=\"menu_dentro0\">";
			while($listado2 = mysqli_fetch_object($result2))
			{
				print "<p><a href=\"herramienta.php?modulo=Especifico&herramienta=".$listado2->FicheroPHP."\"><img src=\"http://".$_SERVER['SERVER_NAME'].$listado2->URLIcono."\">".$listado2->Nombre."</a></p>";

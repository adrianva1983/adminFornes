if ($formato!="listado") 
{
	if ($loginOK) print(json_encode($output));	
}
else
{
	print "<table border=\"1px\">";
	for ($i=0;$i<count($output);$i++)
	{
		print "<tr>";
		print "<th>".htmlentities(utf8_decode($output[$i]["Tienda"]))."</th>";
		print "<td><img src=\"".$output[$i]["Icono"]."\" width=\"50px\"></td>";
		print "<td>Ventas: ".$output[$i]["Ventas"]."</td>";
		print "<td>Comisiones: ".$output[$i]["Comisiones"]."</td>";
		print "</tr>";
	}
	print "<tr><td>&nbsp;</td><td>&nbsp;</td><td><strong>TOTAL VENTAS:".$total_ventas."</strong></td><td><strong>TOTAL COMISIONES:".$total_comisiones."</td></tr>";
	print "</table>";

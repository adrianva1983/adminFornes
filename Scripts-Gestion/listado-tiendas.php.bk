	{
		$requete.="ps_orders.date_add>='".$_REQUEST['fecha1']." 00:00:01' AND ";		
	}
	if (isset($_REQUEST['fecha2'])) 
	{
		$requete.="ps_orders.date_add<='".$_REQUEST['fecha2']." 23:59:59' AND ";		
	}
}
$requete.= "ps_orders.valid=1";

if ($result = mysqli_query($db, $requete))
{
